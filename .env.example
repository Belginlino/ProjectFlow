# ================================================================
# ProjectFlow — Environment Variables Example
# Copy to frontend/.env and fill in your Firebase values.
# NEVER commit real credentials.
# ================================================================

# --- Firebase Project Config (Firebase Console > Project Settings) ---
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# --- Local Emulator (set true when running: firebase emulators:start) ---
VITE_USE_FIREBASE_EMULATOR=false

# --- App Metadata ---
VITE_APP_NAME=ProjectFlow
VITE_APP_ENV=development
