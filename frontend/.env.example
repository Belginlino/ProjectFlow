# Firebase Client Configuration
VITE_FIREBASE_API_KEY="demo-projectflow-api-key"
VITE_FIREBASE_AUTH_DOMAIN="projectflow-demo.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="projectflow-demo"
VITE_FIREBASE_STORAGE_BUCKET="projectflow-demo.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Offline / Demo Mode flag (enables zero-friction local execution without live cloud keys)
VITE_USE_LOCAL_MOCK_STORAGE=false
VITE_USE_FIREBASE_EMULATOR=false
